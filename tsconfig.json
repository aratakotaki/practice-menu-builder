{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,

    /* Type-checking. Strictness is intentionally moderate for now: this is a
       Figma-generated codebase that has never been type-checked, so we start with
       a baseline that catches real bugs without drowning in noise, then tighten
       incrementally (noUnusedLocals / strict null handling come later). */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "/utils/*": ["./utils/*"]
    }
  },
  "include": ["src", "utils", "vite.config.ts"]
}
